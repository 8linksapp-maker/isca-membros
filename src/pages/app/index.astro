---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CURSO } from '../../data/curso';
---

<BaseLayout
  title="Meu curso — Área de membros | Bruno Medeiros"
  description="Dashboard do curso gratuito de SEO — Bruno Medeiros."
  canonical="https://links.brunomedeiroseo.com.br/app"
  noindex
>
  <div class="container" style="padding-block:40px 64px">
    <header class="topo">
      <div>
        <p class="mono" style="color:var(--gray);font-size:13px;margin:0 0 4px">// Meu curso</p>
        <h1 style="font-size:clamp(26px,5vw,36px);margin:0">
          Curso de SEO <span style="color:var(--orange)">gratuito</span>
        </h1>
      </div>
      <button type="button" id="btn-logout" class="btn-sair">Sair</button>
    </header>

    <p class="muted" style="margin:16px 0 32px">
      Continue de onde parou. Escolha uma aula abaixo. 👇
    </p>

    <div class="modulos">
      {CURSO.map((modulo, i) => (
        <section class="modulo card">
          <div class="cabec">
            <span class="badge" aria-hidden="true">Módulo {i + 1}</span>
            <h2 style="font-size:20px;margin:0">{modulo.titulo}</h2>
            <p class="muted" style="margin:4px 0 0;font-size:14px">{modulo.descricao}</p>
          </div>
          <ul class="aulas" aria-label={`Aulas do módulo ${modulo.titulo}`}>
            {modulo.aulas.map((aula) => (
              <li>
                <a href={`/app/aula/${aula.id}`} class="aula-link">
                  <span class="play" aria-hidden="true">▶</span>
                  <span class="titulo-aula">{aula.titulo}</span>
                  <span class="duracao mono">{aula.duracao}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .topo {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn-sair {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--gray);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .btn-sair:hover {
    border-color: var(--orange);
    color: var(--orange);
  }
  .btn-sair:focus-visible {
    outline: 2px solid var(--orange-light);
    outline-offset: 2px;
  }
  .modulos {
    display: grid;
    gap: 20px;
  }
  .modulo {
    padding: 24px;
  }
  .badge {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--orange);
    margin-bottom: 8px;
  }
  .aulas {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    display: grid;
    gap: 8px;
  }
  .aula-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    text-decoration: none;
    color: var(--txt);
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .aula-link:hover {
    border-color: var(--orange);
    background: var(--bg3);
  }
  .aula-link:focus-visible {
    outline: 2px solid var(--orange-light);
    outline-offset: 2px;
  }
  .play {
    color: var(--orange);
    font-size: 13px;
  }
  .titulo-aula {
    flex: 1;
    font-size: 15px;
  }
  .duracao {
    font-size: 12px;
    color: var(--gray);
  }
</style>

<script>
  import { supabaseBrowser } from '../../lib/supabase-browser';

  document.getElementById('btn-logout')?.addEventListener('click', async () => {
    const supabase = supabaseBrowser();
    await supabase.auth.signOut();
    window.location.href = '/membros';
  });
</script>
