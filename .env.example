# --- Supabase (server-side) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Brevo (email de acesso do membro) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=seu-email@seudominio.com.br

# --- Client-side (Build-time! adicionar em Build & deployment > Environment variables
#     do Pages, seção de BUILD, para o bundle do browser) ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
